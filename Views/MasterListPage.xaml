<UserControl x:Class="AttendanceShiftingManagement.Views.MasterListPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AttendanceShiftingManagement.Views"
             xmlns:helpers="clr-namespace:AttendanceShiftingManagement.Helpers"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="900" d:DesignWidth="1440"
             Background="{DynamicResource BrandSurfaceBrush}">
    
    <UserControl.Resources>

        <Style x:Key="SidebarHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource ThemePrimaryActionBrush}" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Typography.Capitals" Value="AllSmallCaps"/>
        </Style>

        <Style x:Key="DetailCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ThemeCardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrandBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>

        <Style x:Key="MetricCardStyle" TargetType="Border">
            <Setter Property="Padding" Value="16" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Background" Value="{DynamicResource ThemeCardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrandBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <!-- Left rail buttons -->
        <Style x:Key="RailPrimaryButton" TargetType="Button" BasedOn="{StaticResource GoldActionButton}">
            <Setter Property="Height" Value="44" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <Style x:Key="RailBrandButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
            <Setter Property="Background" Value="{DynamicResource ThemePrimaryActionBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemePrimaryActionBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Height" Value="44" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <Style x:Key="RailButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
            <Setter Property="Height" Value="42" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="WebTableCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ThemeCardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrandBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="20" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Header Bar (Web Theme: Brand Green #15803D with Live CRS Connection & Query Pills) -->
        <Border Grid.Row="0" Background="{DynamicResource ThemePrimaryActionBrush}" Padding="24,14" Panel.ZIndex="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Title & Subtitle -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="40" Height="40" CornerRadius="10" Background="#26FFFFFF" Margin="0,0,14,0">
                        <materialDesign:PackIcon Kind="AccountMultipleCheck" Width="24" Height="24" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="MASTERLIST &amp; REGISTRY" FontSize="20" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                            <!-- Web Live CRS Connection Badge -->
                            <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="12" Padding="10,2" Margin="12,0,0,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="6" Height="6" Fill="#15803D" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Live CRS Connection" FontSize="11" FontWeight="Bold" Foreground="#15803D" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Direct read-only registry of all validated accounts in Sulop from the central Civil Registry System (CRS)." FontSize="12" Foreground="#CCFFFFFF" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Center: Table Pill -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Background="#1AFFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="8" Padding="10,4">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="CRS: " FontSize="11" FontFamily="Consolas, Segoe UI Mono, Courier New" Foreground="#CCFFFFFF"/>
                            <TextBlock Text="val_beneficiaries" FontSize="11" FontFamily="Consolas, Segoe UI Mono, Courier New" FontWeight="Bold" Foreground="White"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Right: Walkthrough & Sidebar Toggle -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Command="{Binding OpenOnboardingCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Background="White" BorderBrush="Transparent" Foreground="#15803D"
                            Height="36" Padding="12,0" Margin="0,0,10,0"
                            ToolTip="Interactive Masterlist Operator Walkthrough">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="SchoolOutline" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="WALKTHROUGH" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ToggleSidebarCommand}"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Foreground="White" Height="36" Padding="10,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0">
                                <materialDesign:PackIcon.Style>
                                    <Style TargetType="materialDesign:PackIcon">
                                        <Setter Property="Kind" Value="MenuOpen"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                                                <Setter Property="Kind" Value="Menu"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </materialDesign:PackIcon.Style>
                            </materialDesign:PackIcon>
                            <TextBlock VerticalAlignment="Center" FontWeight="Bold" FontSize="11">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="HIDE SIDEBAR"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                                                <Setter Property="Text" Value="SHOW SIDEBAR"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Workspace Area -->
        <Grid Grid.Row="1">
            <Grid.Effect>
                <BlurEffect Radius="0" x:Name="WorkspaceBlur"/>
            </Grid.Effect>
            <Grid.Style>
                <Style TargetType="Grid">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsStandardModalOpen}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(Grid.Effect).(BlurEffect.Radius)" To="15" Duration="0:0:0.3"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(Grid.Effect).(BlurEffect.Radius)" To="0" Duration="0:0:0.3"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{Binding SidebarWidth, FallbackValue=300}" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left Column: Navigation Sidebar (Light Slate #F8FAFC) -->
                <Border Grid.Column="0" Background="{DynamicResource ThemeCardSubtleBrush}" BorderBrush="{DynamicResource BrandBorderBrush}" BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Dashboard & Refresh Bar -->
                        <Grid Grid.Row="0" Margin="16,16,16,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="DASHBOARD"
                                     Command="{Binding DataContext.ShowDashboardCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                     Style="{StaticResource MaterialDesignOutlinedButton}"
                                     Height="40" FontSize="11" FontWeight="Bold"/>
                            <Button Grid.Column="2" Command="{Binding RefreshCommand}"
                                     Style="{StaticResource MaterialDesignOutlinedButton}"
                                     Width="40" Height="40" Padding="0" ToolTip="Refresh lists">
                                <materialDesign:PackIcon Kind="Refresh" Width="20" Height="20"/>
                            </Button>
                        </Grid>

                        <!-- Sidebar Scrollable Tools -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <Border Padding="16,0,16,16">
                                <StackPanel>
                                    <!-- Search Registry -->
                                    <TextBlock Text="SEARCH REGISTRY" Style="{StaticResource SidebarHeaderStyle}"/>
                                    <Border x:Name="SidebarSearchBorder" Background="{DynamicResource ThemeCardBrush}" BorderBrush="{DynamicResource BrandBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,0,16">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <materialDesign:PackIcon Grid.Column="0" Kind="Magnify" Foreground="{DynamicResource BrandTextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" Width="16" Height="16"/>
                                            <TextBox x:Name="SidebarSearchTextBox" Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                                     materialDesign:HintAssist.Hint="Search name, CRN, address..."
                                                     BorderThickness="0" Background="Transparent" VerticalAlignment="Center" FontSize="12"/>
                                            <Button Grid.Column="2" Style="{StaticResource MaterialDesignFlatButton}"
                                                     Padding="0" Width="20" Height="20"
                                                     Visibility="{Binding SearchText, Converter={StaticResource NullToHiddenConverter}}"
                                                     Command="{Binding ClearSearchCommand}"
                                                     ToolTip="Clear Search">
                                                <materialDesign:PackIcon Kind="Close" Width="14" Height="14" Foreground="{DynamicResource BrandTextSecondaryBrush}"/>
                                            </Button>
                                        </Grid>
                                    </Border>

                                    <!-- Digital ID Tools -->
                                    <TextBlock Text="DIGITAL ID &amp; TOOLS" Style="{StaticResource SidebarHeaderStyle}"/>
                                    <Button x:Name="PcScannerButton" Command="{Binding OpenPcScannerCommand}" Style="{StaticResource RailBrandButton}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Cctv" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <TextBlock Text="SCAN VIA PC CAMERA" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <Border Background="{DynamicResource ThemeCardBrush}" BorderBrush="{DynamicResource BrandBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,10,0,0">
                                        <StackPanel>
                                            <TextBlock Text="REGISTRY SCOPE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource ThemePrimaryActionBrush}" Margin="0,0,0,4"/>
                                            <TextBlock Text="{Binding SnapshotSourceSummary}" FontSize="11" Foreground="{DynamicResource BrandTextSecondaryBrush}" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding LastUpdatedSummary}" FontSize="10" Foreground="{DynamicResource BrandTextSecondaryBrush}" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </ScrollViewer>

                        <!-- Sidebar Status / Sync Notification -->
                        <Border Grid.Row="2" Padding="14,10" Background="Transparent" BorderBrush="{DynamicResource BrandBorderBrush}" BorderThickness="0,1,0,0"
                                Visibility="{Binding StatusMessage, Converter={StaticResource NullToHiddenConverter}}">
                            <TextBlock Text="{Binding StatusMessage}" Foreground="{Binding StatusBrush}" FontSize="11" TextAlignment="Center" TextWrapping="Wrap" FontWeight="SemiBold"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Center Main Column: Masterlist Web Replicated View -->
                <Grid Grid.Column="1" Background="Transparent" Margin="24,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Top 4 Metric KPI Cards -->
                    <Grid Grid.Row="0" Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Card 1: Total Registered -->
                        <Border Grid.Column="0" Style="{StaticResource MetricCardStyle}">
                            <StackPanel>
                                <TextBlock Text="TOTAL REGISTERED" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrandTextSecondaryBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding TotalApprovedBeneficiaries, StringFormat=N0}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource BrandMidnightBrush}"/>
                                <TextBlock Text="Central CRS accounts" FontSize="10" Foreground="{DynamicResource BrandTextSecondaryBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Card 2: Civil Registry Linked -->
                        <Border Grid.Column="2" Style="{StaticResource MetricCardStyle}">
                            <StackPanel>
                                <TextBlock Text="CIVIL REGISTRY LINKED" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrandTextSecondaryBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding LinkedCivilRegistryCount, StringFormat=N0}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource BrandSuccessBrush}"/>
                                <TextBlock Text="Verified CRN records" FontSize="10" Foreground="{DynamicResource BrandTextSecondaryBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Card 3: PWD Count -->
                        <Border Grid.Column="4" Style="{StaticResource MetricCardStyle}">
                            <StackPanel>
                                <TextBlock Text="PWD COUNT" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrandTextSecondaryBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding PwdCount, StringFormat=N0}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource BrandMidnightBrush}"/>
                                <TextBlock Text="With disability registry" FontSize="10" Foreground="{DynamicResource BrandTextSecondaryBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Card 4: Senior Citizens -->
                        <Border Grid.Column="6" Style="{StaticResource MetricCardStyle}">
                            <StackPanel>
                                <TextBlock Text="SENIOR CITIZENS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrandTextSecondaryBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding SeniorCount, StringFormat=N0}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource BrandMidnightBrush}"/>
                                <TextBlock Text="Age 60 and above" FontSize="10" Foreground="{DynamicResource BrandTextSecondaryBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Beneficiary Records Main Web Card (index.blade.php replicated) -->
                    <Border Grid.Row="1" Style="{StaticResource WebTableCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Toolbar & Search -->
                            <Grid Grid.Row="0" Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Beneficiary Records" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource BrandMidnightBrush}"/>
                                    <TextBlock Text="Click any row or 'View Profile' to open the complete identity card and disbursement history." FontSize="11" Foreground="{DynamicResource BrandTextSecondaryBrush}" Margin="0,2,0,0"/>
                                </StackPanel>

                                <!-- In-card Search -->
                                <Border Grid.Column="1" Background="{DynamicResource ThemeCardSubtleBrush}" BorderBrush="{DynamicResource BrandBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,4">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <materialDesign:PackIcon Kind="Magnify" Foreground="{DynamicResource BrandTextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" Width="16" Height="16"/>
                                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                                 materialDesign:HintAssist.Hint="Search name, CRN, or household #..."
                                                 Width="240" BorderThickness="0" Background="Transparent" FontSize="12" VerticalAlignment="Center"/>
                                        <Button Style="{StaticResource MaterialDesignFlatButton}"
                                                Padding="0" Width="20" Height="20"
                                                Visibility="{Binding SearchText, Converter={StaticResource NullToHiddenConverter}}"
                                                Command="{Binding ClearSearchCommand}"
                                                ToolTip="Clear Search">
                                            <materialDesign:PackIcon Kind="Close" Width="14" Height="14" Foreground="{DynamicResource BrandTextSecondaryBrush}"/>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Main DataGrid -->
                            <DataGrid Grid.Row="1" x:Name="ApprovedDataGrid" ItemsSource="{Binding ApprovedBeneficiaries}"
                                      SelectedItem="{Binding SelectedApprovedBeneficiary}"
                                      SelectionMode="Single"
                                      AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                      Background="Transparent" BorderThickness="0" HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9"
                                      MouseDoubleClick="Grid_MouseDoubleClick"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                                      materialDesign:DataGridAssist.CellPadding="12,10">
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow" BasedOn="{StaticResource MaterialDesignDataGridRow}">
                                        <EventSetter Event="MouseLeftButtonUp" Handler="DataGridRow_MouseLeftButtonUp"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <!-- 1. Full Name (Primary column, protected from collapsing) -->
                                    <DataGridTextColumn Header="FULL NAME" Binding="{Binding FullName}" Width="2*" MinWidth="180" FontWeight="SemiBold"/>

                                    <!-- 2. Civil Registry ID (CRN) / Beneficiary ID fallback (matching web) -->
                                    <DataGridTemplateColumn Header="Civil Registry ID (CRN)" Width="170" MinWidth="140">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding DisplayId}" FontFamily="Consolas, Segoe UI Mono, Courier New" FontWeight="Bold" Foreground="{DynamicResource ThemePrimaryActionBrush}" VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- 3. Barangay / Address -->
                                    <DataGridTextColumn Header="Barangay / Address" Binding="{Binding Address}" Width="2*" MinWidth="140"/>

                                    <!-- 4. Demographics / Classification -->
                                    <DataGridTextColumn Header="Demographics" Binding="{Binding FlagsSummary}" Width="120"/>

                                    <!-- 5. Birth Date / Age -->
                                    <DataGridTextColumn Header="Birth Date / Age" Binding="{Binding SexAgeSummary}" Width="120"/>

                                    <!-- 6. Status -->
                                    <DataGridTextColumn Header="Status" Binding="{Binding VerificationStatus}" Width="90"/>

                                    <!-- 7. Action -->
                                    <DataGridTemplateColumn Header="Action" Width="120">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Command="{Binding DataContext.OpenFullProfileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                                        BorderBrush="#A7F3D0" Background="#ECFDF5" Foreground="#15803D"
                                                        Height="28" Padding="8,0" FontSize="11" FontWeight="Bold">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="View Profile" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                        <materialDesign:PackIcon Kind="ChevronRight" Width="14" Height="14" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- Pagination Footer -->
                            <Border Grid.Row="2" Margin="0,16,0,0" Padding="0,12,0,0" BorderBrush="{DynamicResource BrandBorderBrush}" BorderThickness="0,1,0,0">
                                <Grid>
                                    <TextBlock Text="{Binding ApprovedPageSummary}" VerticalAlignment="Center" Foreground="{DynamicResource BrandTextSecondaryBrush}" FontSize="12"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Command="{Binding PreviousApprovedPageCommand}" Style="{StaticResource MaterialDesignFlatButton}" Width="36" Height="36" Padding="0">
                                            <materialDesign:PackIcon Kind="ChevronLeft" Width="20" Height="20"/>
                                        </Button>
                                        <TextBlock Text="{Binding ApprovedCurrentPage}" VerticalAlignment="Center" Margin="12,0" FontWeight="Bold" Foreground="{DynamicResource BrandMidnightBrush}"/>
                                        <Button Command="{Binding NextApprovedPageCommand}" Style="{StaticResource MaterialDesignFlatButton}" Width="36" Height="36" Padding="0">
                                            <materialDesign:PackIcon Kind="ChevronRight" Width="20" Height="20"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- Backdrop for Overlays -->
        <Border Grid.RowSpan="2" Background="#CC0F172A" Visibility="{Binding IsStandardModalOpen, Converter={StaticResource BooleanToVisibilityConverter}}" Panel.ZIndex="100"/>

        <!-- PC Scanner Overlay -->
        <Grid Grid.RowSpan="2" Panel.ZIndex="120" Visibility="{Binding IsPcScannerOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <local:DesktopScannerOverlay QrCodeScanned="Scanner_QrCodeScanned" Closed="Scanner_Closed"/>
        </Grid>

        <!-- Project Enrollment Overlay -->
        <Border Grid.RowSpan="2" Panel.ZIndex="130" Background="#CC0F172A" Visibility="{Binding IsEnrollmentPanelOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <materialDesign:Card Width="500" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{DynamicResource ThemePrimaryActionBrush}" Padding="20,15">
                        <TextBlock Text="ENROLL IN PROJECT" Foreground="White" FontSize="18" FontWeight="Bold"/>
                    </Border>

                    <StackPanel Grid.Row="1" Margin="25">
                        <TextBlock Text="SELECT TARGET PROJECT" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ThemePrimaryActionBrush}" Margin="0,0,0,15"/>
                        <ComboBox materialDesign:HintAssist.Hint="Active Projects" 
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                  ItemsSource="{Binding ActiveProjects}"
                                  SelectedItem="{Binding SelectedProjectToEnroll}"
                                  DisplayMemberPath="ProgramName"
                                  Margin="0,0,0,20"/>
                        
                        <TextBlock Text="The selected approved beneficiaries will be added to this project's distribution list." 
                                   FontSize="12" TextWrapping="Wrap" Foreground="#64748B"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20">
                        <Button Content="CANCEL" Style="{StaticResource MaterialDesignFlatButton}" Command="{Binding CloseEnrollmentPanelCommand}" Margin="0,0,10,0" Foreground="#64748B"/>
                        <Button Content="CONFIRM ENROLLMENT" 
                                Command="{Binding ConfirmEnrollmentCommand}" 
                                CommandParameter="{Binding ElementName=ApprovedDataGrid, Path=SelectedItems}"
                                Style="{StaticResource MaterialDesignRaisedButton}" 
                                Background="{DynamicResource BrandYellowBrush}" BorderBrush="{DynamicResource BrandYellowBrush}" Foreground="White"/>
                    </StackPanel>
                </Grid>
            </materialDesign:Card>
        </Border>

        <!-- ========================================================================= -->
        <!-- FULL-SCREEN IN-PAGE PROFILE OVERLAY (Replicating profile.blade.php)        -->
        <!-- ========================================================================= -->
        <Border Grid.RowSpan="2" Panel.ZIndex="140" Background="{DynamicResource BrandSurfaceBrush}"
                Visibility="{Binding IsFullProfileOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Top Header Bar with Back Button (Replicating profile.blade.php Header) -->
                <Border Grid.Row="0" Background="{DynamicResource ThemePrimaryActionBrush}" Padding="24,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Back Button & Profile Title -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Command="{Binding CloseFullProfileCommand}"
                                    Style="{StaticResource MaterialDesignFlatButton}"
                                    Foreground="White" Height="38" Padding="10,0">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ArrowLeft" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="BACK" VerticalAlignment="Center" FontWeight="Bold"/>
                                </StackPanel>
                            </Button>
                            <Border Width="1" Background="#33FFFFFF" Margin="12,4"/>
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Beneficiary Profile" FontSize="18" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                    <!-- CRS Verified Citizen Pill -->
                                    <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="12" Padding="10,2" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="CRS Verified Citizen" FontSize="11" FontWeight="Bold" Foreground="#15803D" VerticalAlignment="Center"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock FontSize="12" Foreground="#CCFFFFFF" Margin="0,2,0,0">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="Civil Registry Record #{0} • Live consolidated claims history">
                                            <Binding Path="SelectedBeneficiary.CivilRegistryId" FallbackValue="--"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>

                        <!-- Right Actions & Close Shortcut (Relocated QuickActionsPanel) -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" x:Name="QuickActionsPanel">
                            <!-- Approve & Issue ID -->
                            <Button x:Name="ApproveButton" Command="{Binding ApproveCommand}"
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    Background="#10B981" BorderBrush="#059669" Foreground="White"
                                    Height="36" Padding="12,0" Margin="0,0,8,0"
                                    ToolTip="Approve record and issue digital ID">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="CheckDecagram" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="APPROVE &amp; ISSUE ID" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Reject Record -->
                            <Button Command="{Binding RejectCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    BorderBrush="#FCA5A5" Background="#FEF2F2" Foreground="#DC2626"
                                    Height="36" Padding="10,0" Margin="0,0,8,0"
                                    ToolTip="Reject this beneficiary record">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="CloseCircleOutline" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="REJECT" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Enroll in Project -->
                            <Button x:Name="EnrollmentButton" Command="{Binding OpenEnrollmentPanelCommand}"
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    Background="#D97706" BorderBrush="#B45309" Foreground="White"
                                    Height="36" Padding="12,0" Margin="0,0,8,0"
                                    ToolTip="Enroll beneficiary into an active project">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="AccountArrowRight" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="ENROLL" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Print ID / View Profile Button -->
                            <Button x:Name="ViewFullProfileButton" Command="{Binding PrintDigitalIdCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Background="#1AFFFFFF" BorderBrush="#33FFFFFF" Foreground="White"
                                    Height="36" Padding="12,0" Margin="0,0,8,0"
                                    ToolTip="Print official digital citizen ID card">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Printer" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="PRINT ID" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Back to Masterlist Button -->
                            <Button Command="{Binding CloseFullProfileCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Background="#1AFFFFFF" BorderBrush="#33FFFFFF" Foreground="White"
                                    Height="36" Padding="14,0">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FormatListBulleted" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Back to Masterlist" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Profile Body ScrollViewer (2-Column Layout matching profile.blade.php) -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="28">
                    <Grid MaxWidth="1280" HorizontalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="460"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- LEFT COLUMN: CRS Citizen Identity Card + HOUSEHOLD -->
                        <StackPanel Grid.Column="0">
                            <!-- CRS Citizen Identity Card -->
                            <Border Style="{StaticResource DetailCardStyle}">
                                <StackPanel>
                                    <!-- Card Header with Monogram -->
                                    <Grid Margin="0,0,0,16" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="CIVIL REGISTRY IDENTITY" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrandTextSecondaryBrush}" Typography.Capitals="AllSmallCaps"/>
                                            <TextBlock Text="{Binding SelectedBeneficiary.DisplayName, FallbackValue='Citizen Record'}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource BrandMidnightBrush}" Margin="0,2,0,0"/>
                                            <TextBlock Text="{Binding SelectedBeneficiary.CivilRegistryId, StringFormat='CRN: {0}', FallbackValue='CRN: --'}" FontSize="12" FontFamily="Consolas, Segoe UI Mono, Courier New" FontWeight="Bold" Foreground="{DynamicResource ThemePrimaryActionBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <!-- Initials Monogram Badge -->
                                        <Border Grid.Column="1" Width="44" Height="44" CornerRadius="12" Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1">
                                            <TextBlock Text="{Binding SelectedBeneficiary.Initials, FallbackValue='CR'}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource ThemePrimaryActionBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </Grid>

                                    <!-- 2-Column Details Grid -->
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Row 0: Barangay & Household No -->
                                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,12">
                                            <TextBlock Text="BARANGAY" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrandTextSecondaryBrush}"/>
                                            <TextBlock Text="{Binding SelectedBeneficiary.Address, FallbackValue='N/A'}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource BrandMidnightBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,12">
                                            <TextBlock Text="HOUSEHOLD NO." FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrandTextSecondaryBrush}"/>
                                            <TextBlock Text="{Binding HouseholdCode, FallbackValue='N/A'}" FontSize="12" FontFamily="Consolas, Segoe UI Mono, Courier New" FontWeight="Bold" Foreground="{DynamicResource BrandMidnightBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <!-- Row 1: Gender & Birth Date -->
                                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,12">
                                            <TextBlock Text="GENDER" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrandTextSecondaryBrush}"/>
                                            <TextBlock Text="{Binding SelectedBeneficiary.Sex, FallbackValue='N/A'}" FontSize="12" Foreground="{DynamicResource BrandMidnightBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,12">
                                            <TextBlock Text="BIRTH DATE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrandTextSecondaryBrush}"/>
                                            <TextBlock Text="{Binding SelectedBeneficiary.DateOfBirth, FallbackValue='N/A'}" FontSize="12" Foreground="{DynamicResource BrandMidnightBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <!-- Row 2: Age & Classification -->
                                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,8,12">
                                            <TextBlock Text="AGE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrandTextSecondaryBrush}"/>
                                            <TextBlock Text="{Binding SelectedBeneficiary.Age, StringFormat='{}{0} years old', FallbackValue='N/A'}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource BrandMidnightBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Grid.Column="1" Margin="8,0,0,12">
                                            <TextBlock Text="SPECIAL CLASSIFICATION" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrandTextSecondaryBrush}"/>
                                            <TextBlock Text="{Binding SelectedBeneficiary.FlagsSummary, FallbackValue='Regular Resident'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ThemePrimaryActionBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <!-- Row 3: Beneficiary ID & Data Source -->
                                        <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,8,0">
                                            <TextBlock Text="BENEFICIARY ID" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrandTextSecondaryBrush}"/>
                                            <TextBlock Text="{Binding SelectedBeneficiary.BeneficiaryId, FallbackValue='--'}" FontSize="12" FontFamily="Consolas, Segoe UI Mono, Courier New" Foreground="{DynamicResource BrandMidnightBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="3" Grid.Column="1" Margin="8,0,0,0">
                                            <TextBlock Text="DATA SOURCE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrandTextSecondaryBrush}"/>
                                            <TextBlock Text="eRehistro (CRS)" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource ThemePrimaryActionBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Permanent Address Row -->
                                    <Border BorderBrush="{DynamicResource BrandBorderBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="0,4,0,0">
                                        <StackPanel>
                                            <TextBlock Text="PERMANENT ADDRESS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrandTextSecondaryBrush}"/>
                                            <TextBlock Text="{Binding SelectedBeneficiary.Address, FallbackValue='--'}" FontSize="12" Foreground="{DynamicResource BrandMidnightBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- HOUSEHOLD CARD (Required Invariants Preserved) -->
                            <Border Style="{StaticResource DetailCardStyle}">
                                <StackPanel>
                                    <Label Content="HOUSEHOLD" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource ThemePrimaryActionBrush}" Padding="0" Margin="0,0,0,12"/>

                                    <!-- Empty state -->
                                    <StackPanel HorizontalAlignment="Center" Margin="0,16,0,10"
                                                Visibility="{Binding HasHouseholdContext, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                        <materialDesign:PackIcon Kind="HomeOffOutline" Width="36" Height="36" HorizontalAlignment="Center" Foreground="{DynamicResource BrandTextSecondaryBrush}"/>
                                        <TextBlock Text="No household linked to this beneficiary." FontSize="12" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0" Foreground="{DynamicResource BrandTextSecondaryBrush}"/>
                                    </StackPanel>

                                    <!-- Household summary & members list -->
                                    <StackPanel Visibility="{Binding HasHouseholdContext, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Grid Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Household Code" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrandTextSecondaryBrush}" Margin="0,0,0,2"/>
                                                <TextBlock Text="{Binding HouseholdCode}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource BrandMidnightBrush}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="Head of Household" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrandTextSecondaryBrush}" Margin="0,0,0,2"/>
                                                <TextBlock Text="{Binding HouseholdHeadName}" FontSize="12" Foreground="{DynamicResource BrandMidnightBrush}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Text="Address / Purok" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrandTextSecondaryBrush}" Margin="0,0,0,2"/>
                                        <TextBlock Text="{Binding HouseholdAddressSummary}" FontSize="12" Foreground="{DynamicResource BrandMidnightBrush}" TextWrapping="Wrap" Margin="0,0,0,14"/>

                                        <TextBlock Text="HOUSEHOLD MEMBERS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource ThemePrimaryActionBrush}" Margin="0,0,0,8"/>
                                        <ItemsControl ItemsSource="{Binding SelectedHouseholdMembers}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border CornerRadius="8" Padding="12,8" Margin="0,0,0,6" Background="{DynamicResource ThemeCardSubtleBrush}" BorderBrush="{DynamicResource BrandBorderBrush}" BorderThickness="1">
                                                        <StackPanel>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding FullName}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrandMidnightBrush}" TextWrapping="Wrap"/>
                                                                <materialDesign:PackIcon Kind="AccountCheck" Width="14" Height="14" Margin="6,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource BrandSuccessBrush}" ToolTip="Selected beneficiary"
                                                                                         Visibility="{Binding IsSelectedBeneficiary, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding RelationshipToHead}" FontSize="10" Foreground="{DynamicResource BrandTextSecondaryBrush}"/>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Digital ID & QR Card -->
                            <Border Style="{StaticResource DetailCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="DIGITAL ID &amp; VERIFICATION" Style="{StaticResource SidebarHeaderStyle}"/>
                                    <Border Width="120" Height="120" HorizontalAlignment="Center" CornerRadius="12" Background="{DynamicResource ThemeCardSubtleBrush}" ClipToBounds="True" Margin="0,4,0,10">
                                        <Grid>
                                            <materialDesign:PackIcon Kind="Account" Width="48" Height="48" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <Image Source="{Binding DigitalIdPhotoImage}" Stretch="UniformToFill"/>
                                        </Grid>
                                    </Border>
                                    <TextBlock Text="{Binding DigitalIdCardNumber}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource BrandMidnightBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding DigitalIdIssuedAtText}" FontSize="11" Foreground="{DynamicResource BrandTextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/>

                                    <Border Background="White" BorderBrush="{DynamicResource BrandBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,12,0,0" HorizontalAlignment="Center"
                                            Visibility="{Binding DigitalIdQrImage, Converter={StaticResource NullToHiddenConverter}}">
                                        <Image Source="{Binding DigitalIdQrImage}" Height="110" Width="110" Stretch="Uniform"/>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- RIGHT COLUMN: Benefits Lifetime Stats & Acquired Benefits & Claims History -->
                        <StackPanel Grid.Column="2">
                            <!-- Lifetime Benefits Summary KPI Cards (Replicating profile.blade.php) -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Card 1: Total Ayuda Disbursed -->
                                <Border Grid.Column="0" Style="{StaticResource DetailCardStyle}" Margin="0">
                                    <StackPanel>
                                        <TextBlock Text="TOTAL AYUDA DISBURSED" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrandTextSecondaryBrush}"/>
                                        <TextBlock Text="{Binding TotalBenefitsReceivedFormatted, FallbackValue='₱0.00'}" FontSize="24" FontWeight="Bold" FontFamily="Consolas, Segoe UI Mono, Courier New" Foreground="{DynamicResource ThemePrimaryActionBrush}" Margin="0,6,0,0"/>
                                        <TextBlock Text="Across all municipal assistance programs" FontSize="11" Foreground="{DynamicResource BrandTextSecondaryBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Card 2: Verified Assistance Events -->
                                <Border Grid.Column="2" Style="{StaticResource DetailCardStyle}" Margin="0">
                                    <StackPanel>
                                        <TextBlock Text="VERIFIED ASSISTANCE EVENTS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrandTextSecondaryBrush}"/>
                                        <TextBlock Text="{Binding TotalClaimsCount, FallbackValue='0'}" FontSize="24" FontWeight="Bold" FontFamily="Consolas, Segoe UI Mono, Courier New" Foreground="{DynamicResource BrandMidnightBrush}" Margin="0,6,0,0"/>
                                        <TextBlock Text="Completed disbursement claims" FontSize="11" Foreground="{DynamicResource BrandTextSecondaryBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Central Audit-Verified Claims Banner (profile.blade.php replicated) -->
                            <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="12" Padding="16,12" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="26" Height="26" CornerRadius="6" Background="#D1FAE5" VerticalAlignment="Top" Margin="0,0,12,0">
                                        <materialDesign:PackIcon Kind="CheckDecagram" Width="18" Height="18" Foreground="{DynamicResource ThemePrimaryActionBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Central Audit-Verified Claims" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource ThemePrimaryActionBrush}"/>
                                        <TextBlock Text="Claims below represent real-time local records matched by Civil Registry ID against Project Distribution releases and GGMS consolidated transactions."
                                                   FontSize="11" Foreground="#334155" TextWrapping="Wrap" LineHeight="16" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Acquired Benefits & Claims History Card -->
                            <Border Style="{StaticResource DetailCardStyle}">
                                <StackPanel>
                                    <!-- History Header -->
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Acquired Benefits &amp; Claims History" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource BrandMidnightBrush}"/>
                                            <TextBlock Text="Full immutable timeline of all aid released to this individual." FontSize="11" Foreground="{DynamicResource BrandTextSecondaryBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <Border Grid.Column="1" Background="{DynamicResource ThemeCardSubtleBrush}" BorderBrush="{DynamicResource BrandBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="10,4" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding TotalClaimsCount, StringFormat='{}{0} Records Found'}" FontSize="11" FontFamily="Consolas, Segoe UI Mono, Courier New" FontWeight="Bold" Foreground="{DynamicResource BrandMidnightBrush}"/>
                                        </Border>
                                    </Grid>

                                    <!-- History List / Empty State / Spinner -->
                                    <Grid MinHeight="220">
                                        <!-- Actual Ledger Items List -->
                                        <ListBox ItemsSource="{Binding SelectedBeneficiaryHistory}"
                                                 Background="Transparent" BorderThickness="0"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Padding="14,12" Margin="0,0,0,8" Background="{DynamicResource ThemeCardSubtleBrush}" BorderBrush="{DynamicResource BrandBorderBrush}" BorderThickness="1" CornerRadius="10">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="130"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="120"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <!-- Col 0: Release Date -->
                                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding ReleaseDate, StringFormat='{}{0:MMM dd, yyyy}'}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource BrandMidnightBrush}"/>
                                                                <TextBlock Text="{Binding ReleaseDate, StringFormat='{}{0:hh:mm tt}'}" FontSize="10" Foreground="{DynamicResource BrandTextSecondaryBrush}"/>
                                                            </StackPanel>

                                                            <!-- Col 1: Program Title & Module Source -->
                                                            <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Remarks}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource BrandMidnightBrush}" TextWrapping="Wrap"/>
                                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                                    <Border Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="0,0,6,0">
                                                                        <TextBlock Text="{Binding SourceModule}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource BrandTextSecondaryBrush}"/>
                                                                    </Border>
                                                                    <TextBlock Text="{Binding SourceRecordId, StringFormat='Ref: {0}'}" FontSize="10" FontFamily="Consolas, Segoe UI Mono, Courier New" Foreground="{DynamicResource BrandTextSecondaryBrush}" VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                            </StackPanel>

                                                            <!-- Col 2: Amount -->
                                                            <TextBlock Grid.Column="2" Text="{Binding Amount, StringFormat='₱{0:N2}'}" FontSize="13" FontWeight="Bold" FontFamily="Consolas, Segoe UI Mono, Courier New" Foreground="{DynamicResource ThemePrimaryActionBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>

                                                            <!-- Col 3: Status Badge -->
                                                            <Border Grid.Column="3" Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="6" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center">
                                                                <TextBlock Text="Disbursed" FontSize="10" FontWeight="Bold" Foreground="#15803D"/>
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>

                                        <!-- Loading Spinner -->
                                        <ProgressBar IsIndeterminate="True" Width="36" Height="36"
                                                     Visibility="{Binding IsHistoryLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                     Style="{StaticResource MaterialDesignCircularProgressBar}"/>

                                        <!-- Empty State -->
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                                    Visibility="{Binding HistoryEmptyStateVisibility}">
                                            <materialDesign:PackIcon Kind="History" Width="44" Height="44" Foreground="{DynamicResource BrandBorderBrush}" HorizontalAlignment="Center"/>
                                            <TextBlock Text="No prior assistance claims recorded for this beneficiary." Foreground="{DynamicResource BrandTextSecondaryBrush}" FontSize="12" Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ============ INTERACTIVE SPOTLIGHT ONBOARDING WALKTHROUGH ============ -->
        <Grid x:Name="SpotlightOverlayGrid" Grid.RowSpan="2" Panel.ZIndex="150"
              Visibility="{Binding IsOnboardingOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            
            <!-- Dimmed Background with transparent cutout hole -->
            <Path x:Name="SpotlightMaskPath" Fill="#CC0F172A" IsHitTestVisible="True" ClipToBounds="True"/>

            <!-- Spotlight Focus Indicator (Glowing Ring around target) -->
            <Border x:Name="SpotlightBorder" IsHitTestVisible="False"
                    BorderBrush="{DynamicResource BrandYellowBrush}" BorderThickness="2.5"
                    CornerRadius="10" Visibility="Collapsed">
                <Border.Effect>
                    <DropShadowEffect Color="#F59E0B" BlurRadius="22" ShadowDepth="0" Opacity="0.9"/>
                </Border.Effect>
            </Border>

            <!-- Floating Instructional Popover Card -->
            <Canvas x:Name="SpotlightCanvas" IsHitTestVisible="True" ClipToBounds="False">
                <materialDesign:Card x:Name="InstructionCard" Width="430"
                                     UniformCornerRadius="16" Background="White"
                                     IsHitTestVisible="True"
                                     materialDesign:ElevationAssist.Elevation="Dp16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Border Grid.Row="0" Background="{DynamicResource ThemePrimaryActionBrush}" Padding="20,14" CornerRadius="16,16,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                        <materialDesign:PackIcon Kind="SchoolOutline" Width="18" Height="18" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="OPERATOR WALKTHROUGH" Foreground="White" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding OnboardingTitle}" Foreground="White" FontSize="16" FontWeight="Bold" TextWrapping="Wrap"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="#33FFFFFF" CornerRadius="10" Padding="8,3" Margin="0,0,8,0">
                                        <TextBlock Foreground="White" FontSize="11" FontWeight="Bold">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="Step {0} of 4">
                                                    <Binding Path="OnboardingStep"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </Border>
                                    <Button Style="{StaticResource MaterialDesignIconButton}" Foreground="White"
                                            Command="{Binding CloseOnboardingCommand}" Width="26" Height="26" Padding="0">
                                        <materialDesign:PackIcon Kind="Close" Width="16" Height="16"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Body -->
                        <StackPanel Grid.Row="1" Margin="20,16">
                            <TextBlock Text="{Binding OnboardingInstruction}"
                                       Foreground="#334155" FontSize="13" TextWrapping="Wrap" LineHeight="19" Margin="0,0,0,14"/>

                            <!-- Dynamic Action Prompt Box -->
                            <Border Background="#FEF3C7" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="8" Padding="12,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Grid.Column="0" Kind="CursorDefaultClickOutline" Foreground="#B45309" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding OnboardingActionHint}" Foreground="#92400E" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- Footer Navigation -->
                        <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="{DynamicResource BrandBorderBrush}" BorderThickness="0,1,0,0" Padding="18,12" CornerRadius="0,0,16,16">
                            <Grid>
                                <!-- Step Indicator Dots -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <Button Command="{Binding SetOnboardingStepCommand}" CommandParameter="1" Style="{StaticResource MaterialDesignIconButton}" Width="16" Height="16" Padding="0" Margin="0,0,4,0">
                                        <Ellipse Width="8" Height="8">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="#CBD5E1"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding OnboardingStep}" Value="1">
                                                            <Setter Property="Fill" Value="{DynamicResource ThemePrimaryActionBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                    </Button>

                                    <Button Command="{Binding SetOnboardingStepCommand}" CommandParameter="2" Style="{StaticResource MaterialDesignIconButton}" Width="16" Height="16" Padding="0" Margin="0,0,4,0">
                                        <Ellipse Width="8" Height="8">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="#CBD5E1"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding OnboardingStep}" Value="2">
                                                            <Setter Property="Fill" Value="{DynamicResource ThemePrimaryActionBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                    </Button>

                                    <Button Command="{Binding SetOnboardingStepCommand}" CommandParameter="3" Style="{StaticResource MaterialDesignIconButton}" Width="16" Height="16" Padding="0" Margin="0,0,4,0">
                                        <Ellipse Width="8" Height="8">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="#CBD5E1"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding OnboardingStep}" Value="3">
                                                            <Setter Property="Fill" Value="{DynamicResource ThemePrimaryActionBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                    </Button>

                                    <Button Command="{Binding SetOnboardingStepCommand}" CommandParameter="4" Style="{StaticResource MaterialDesignIconButton}" Width="16" Height="16" Padding="0">
                                        <Ellipse Width="8" Height="8">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="#CBD5E1"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding OnboardingStep}" Value="4">
                                                            <Setter Property="Fill" Value="{DynamicResource ThemePrimaryActionBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                    </Button>
                                </StackPanel>

                                <!-- Action Buttons -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="SKIP" Command="{Binding CloseOnboardingCommand}"
                                            Style="{StaticResource MaterialDesignFlatButton}"
                                            Foreground="{DynamicResource BrandTextSecondaryBrush}"
                                            Margin="0,0,6,0" Padding="8,0" Height="32" FontSize="11"/>

                                    <Button Content="BACK" Command="{Binding PreviousOnboardingStepCommand}"
                                            BorderBrush="{DynamicResource BrandBorderBrush}"
                                            Foreground="{DynamicResource BrandMidnightBrush}"
                                            Height="32" Padding="12,0" Margin="0,0,6,0" FontSize="11">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
                                                <Setter Property="IsEnabled" Value="True"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding OnboardingStep}" Value="1">
                                                        <Setter Property="IsEnabled" Value="False"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <Button Command="{Binding NextOnboardingStepCommand}"
                                            Background="{DynamicResource BrandYellowBrush}"
                                            BorderBrush="{DynamicResource BrandYellowBrush}"
                                            Foreground="White"
                                            Height="32" Padding="14,0" FontSize="11">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                                                <Setter Property="Content" Value="NEXT STEP"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding OnboardingStep}" Value="4">
                                                        <Setter Property="Content" Value="FINISH"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </materialDesign:Card>
            </Canvas>
        </Grid>
    </Grid>
</UserControl>
