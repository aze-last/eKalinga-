<UserControl x:Class="AttendanceShiftingManagement.Views.SeminarAttendancePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:helpers="clr-namespace:AttendanceShiftingManagement.Helpers"
             xmlns:local="clr-namespace:AttendanceShiftingManagement.Views"
             mc:Ignorable="d"
             d:DesignHeight="900"
             d:DesignWidth="1440"
             Background="{DynamicResource BrandSurfaceBrush}">
    <UserControl.Resources>
        <SolidColorBrush x:Key="ThemePrimaryActionBrush" Color="#15803D" />
        <SolidColorBrush x:Key="ThemeAccentSoftBrush" Color="#F0FDF4" />
        <SolidColorBrush x:Key="ThemeAccentBorderBrush" Color="#BBF7D0" />
        <SolidColorBrush x:Key="BrandRedBrush" Color="#BE123C" />
        <SolidColorBrush x:Key="CardBorderBrush" Color="#E2E8F0" />
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#F8FAFC" />

        <Style x:Key="SidebarHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource ThemePrimaryActionBrush}" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Typography.Capitals" Value="AllSmallCaps"/>
        </Style>

        <Style x:Key="DetailCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>

        <Style x:Key="MetricCardStyle" TargetType="Border">
            <Setter Property="Padding" Value="16" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>

        <Style x:Key="PanelCardStyle" TargetType="Border">
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="25" ShadowDepth="4" Opacity="0.15" />
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ==================================================================================== -->
        <!-- HEADER BANNER: Background #15803D | Padding 20,15                                    -->
        <!-- ==================================================================================== -->
        <Border Grid.Row="0" Background="{StaticResource ThemePrimaryActionBrush}" Padding="20,15" Panel.ZIndex="10">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="Presentation" Width="32" Height="32" Foreground="White" VerticalAlignment="Center"/>
                    <StackPanel Margin="15,0,0,0">
                        <TextBlock Text="SEMINARS &amp; TRAININGS" FontSize="24" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="Track attendance, manage shifts, and monitor participant turnout" FontSize="12" Foreground="#CCFFFFFF"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="DASHBOARD"
                            Command="{Binding DataContext.ShowDashboardCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Foreground="White" BorderBrush="White" Height="40" Margin="0,0,10,0" FontWeight="Bold"/>

                    <Button Content="+ NEW EVENT VIA BUDGET"
                            Command="{Binding OpenCreateSeminarPanelCommand}"
                            Style="{StaticResource GoldActionButton}"
                            Height="40" Margin="0,0,10,0" FontWeight="Bold"/>

                    <Button Content="REFRESH WORKSPACE"
                            Command="{Binding RefreshWorkspaceCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Foreground="White" BorderBrush="White" Height="40" Margin="0,0,10,0"/>

                    <Button Command="{Binding DataContext.ShowHistoryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Foreground="White" Width="40" Height="40" Padding="0"
                            ToolTip="View Event History">
                        <materialDesign:PackIcon Kind="History" Width="22" Height="22"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================================================================================== -->
        <!-- WORKSPACE CANVAS: Background #F1F5F9 | Padding 24                                    -->
        <!-- ==================================================================================== -->
        <Grid Grid.Row="1" Background="#F1F5F9">
            <Grid.Effect>
                <BlurEffect Radius="0" x:Name="BackgroundBlur"/>
            </Grid.Effect>
            <Grid.Style>
                <Style TargetType="Grid">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsAnyOverlayOpen}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(Grid.Effect).(BlurEffect.Radius)" To="15" Duration="0:0:0.25"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(Grid.Effect).(BlurEffect.Radius)" To="0" Duration="0:0:0.25"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <!-- Hidden scanner textbox for physical USB barcode/QR scanner capture -->
            <TextBox x:Name="HiddenScannerTextBox" Text="{Binding ScannerInputText, UpdateSourceTrigger=PropertyChanged}" 
                     Opacity="0" Width="1" Height="1" Focusable="True"
                     HorizontalAlignment="Left" VerticalAlignment="Top"/>

            <Grid Margin="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ================================================================================ -->
                <!-- FIXED SIDEBAR RAIL (Width 320px) | Background #F8FAFC, Radius 14px               -->
                <!-- ================================================================================ -->
                <Border Grid.Column="0" Background="{StaticResource SidebarBackgroundBrush}"
                        BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                        CornerRadius="14" x:Name="SidebarContainer">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Dashboard Navigation Button -->
                        <Border Grid.Row="0" Padding="16,16,16,8">
                            <Button Content="DASHBOARD" 
                                    Command="{Binding DataContext.ShowDashboardCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Foreground="{StaticResource ThemePrimaryActionBrush}"
                                    BorderBrush="{StaticResource ThemePrimaryActionBrush}"
                                    Height="42" FontWeight="Bold"/>
                        </Border>

                        <!-- Scrollable Action Rail -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16,8,16,16">
                            <StackPanel>
                                <!-- 1. ACTIVE EVENT SELECTOR -->
                                <TextBlock Text="ACTIVE SEMINAR SELECTOR" Style="{StaticResource SidebarHeaderStyle}"/>
                                <Border Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,14">
                                    <StackPanel>
                                        <ComboBox ItemsSource="{Binding Events}" SelectedItem="{Binding SelectedEvent}"
                                                  DisplayMemberPath="Title"
                                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                                  materialDesign:HintAssist.Hint="Select Seminar Event"
                                                  Margin="0,0,0,10" Height="44"/>

                                        <UniformGrid Columns="2">
                                            <Button Content="BROWSE SEMINARS" Click="Browse_Click"
                                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                                    Height="36" FontSize="10" FontWeight="Bold" Margin="0,0,4,0"/>
                                            <Button Content="+ NEW SEMINAR"
                                                    Command="{Binding OpenCreateSeminarPanelCommand}"
                                                    Style="{StaticResource GoldActionButton}"
                                                    Height="36" FontSize="10" FontWeight="Bold" Margin="4,0,0,0"/>
                                        </UniformGrid>
                                    </StackPanel>
                                </Border>

                                <!-- 2. LIVE SCANNER DOCK -->
                                <TextBlock Text="LIVE SCANNER DOCK" Style="{StaticResource SidebarHeaderStyle}"/>
                                <Border Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,14">
                                    <StackPanel>
                                        <Border Background="{StaticResource ThemeAccentSoftBrush}" BorderBrush="{StaticResource ThemeAccentBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,10">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="BarcodeScan" Width="20" Height="20" Foreground="{StaticResource ThemePrimaryActionBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBlock Text="USB Scanner Ready" FontSize="12" FontWeight="Bold" Foreground="{StaticResource ThemePrimaryActionBrush}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Last Scanned Preview Card -->
                                        <Border Background="#F8FAFC" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10"
                                                Visibility="{Binding HasScannedBeneficiary, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="48"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="44" Height="44" CornerRadius="6" Background="#E2E8F0">
                                                    <Grid>
                                                        <materialDesign:PackIcon Kind="Account" Width="28" Height="28" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        <Border CornerRadius="6" Visibility="{Binding ScannedBeneficiaryPhoto, Converter={StaticResource NullToHiddenConverter}}">
                                                            <Border.Background>
                                                                <ImageBrush ImageSource="{Binding ScannedBeneficiaryPhoto}" Stretch="UniformToFill"/>
                                                            </Border.Background>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding ScannedBeneficiary.FullName}" FontSize="12" FontWeight="Bold" Foreground="#0F172A" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding ScannedBeneficiary.BeneficiaryId}" FontSize="10" Foreground="#64748B"/>
                                                    <TextBlock Text="{Binding ScannedBeneficiaryStatus}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource ThemePrimaryActionBrush}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- 3. PRIMARY ACTION CTAs -->
                                <TextBlock Text="WORKFLOW ACTIONS" Style="{StaticResource SidebarHeaderStyle}"/>
                                <Button Content="SCAN ATTENDANCE (GATEWAY)"
                                        Command="{Binding OpenScanAttendancePanelCommand}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        HorizontalContentAlignment="Left" Height="42" Margin="0,0,0,8" FontSize="12" FontWeight="Bold"/>

                                <Button Content="START PC CAMERA SCANNER"
                                        Command="{Binding OpenPcScannerCommand}"
                                        Style="{StaticResource GoldActionButton}"
                                        HorizontalContentAlignment="Left" Height="42" Margin="0,0,0,8" FontSize="12" FontWeight="Bold"/>

                                <Button Content="ACTIVE ANNOUNCEMENTS"
                                        Command="{Binding OpenAnnouncementsPanelCommand}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        HorizontalContentAlignment="Left" Height="42" Margin="0,0,0,8" FontSize="12"/>

                                <Button Content="DELETE SEMINAR"
                                        Command="{Binding DeleteSeminarCommand}"
                                        Height="36" Style="{StaticResource MaterialDesignFlatButton}" Foreground="{StaticResource BrandRedBrush}"
                                        HorizontalContentAlignment="Left" Margin="0,8,0,0"/>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Module Status Footer -->
                        <Border Grid.Row="2" Padding="16,12" Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,1,0,0" CornerRadius="0,0,14,14">
                            <StackPanel>
                                <TextBlock Text="MODULE STATUS" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,2"/>
                                <TextBlock Text="{Binding StatusMessage}" Foreground="{Binding StatusBrush}" FontSize="11" TextWrapping="Wrap" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- ================================================================================ -->
                <!-- MAIN OPERATIONAL STAGE (Grid.Column="1" Margin="20,0,0,0")                       -->
                <!-- ================================================================================ -->
                <Grid Grid.Column="1" Margin="20,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Empty State View (When no seminar selected) -->
                    <Border Grid.Row="0" Grid.RowSpan="2" Style="{StaticResource DetailCardStyle}" Padding="40"
                            Visibility="{Binding SelectedEvent, Converter={StaticResource NullToHiddenConverter}, ConverterParameter=Inverse}"
                            VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="500">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="PresentationPlay" Width="64" Height="64" Foreground="{StaticResource CardBorderBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="No Seminar Selected" FontSize="20" FontWeight="Bold" Foreground="#0F172A" Margin="0,16,0,8" HorizontalAlignment="Center"/>
                            <TextBlock Text="Select an existing seminar session or spawn a new community training session."
                                       FontSize="13" Foreground="#64748B" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,24"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="BROWSE SEMINARS" Style="{StaticResource MaterialDesignOutlinedButton}" Height="44" Padding="20,0" Click="Browse_Click" Margin="0,0,12,0"/>
                                <Button Content="+ CREATE SEMINAR" Style="{StaticResource GoldActionButton}" Height="44" Padding="20,0"
                                        Command="{Binding OpenCreateSeminarPanelCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Active Seminar Operational Workspace -->
                    <Grid Grid.Row="0" Grid.RowSpan="2" Visibility="{Binding SelectedEvent, Converter={StaticResource NullToHiddenConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- 1. EVENT HEADER & COMPACT KPI STAT STRIP -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,16">
                            <!-- Event Title Bar -->
                            <Border Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20,16" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Text="{Binding SelectedEvent.Title}" FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
                                            <Border Background="{StaticResource ThemeAccentSoftBrush}" BorderBrush="{StaticResource ThemeAccentBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding SelectedEvent.StatusText}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource ThemePrimaryActionBrush}"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding SelectedEvent.DateRangeFormatted}" FontSize="12" Foreground="#64748B"/>
                                    </StackPanel>

                                    <!-- Quick Actions -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="EDIT SEMINAR" Command="{Binding OpenEditSeminarPanelCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Height="38" Margin="0,0,8,0"/>
                                        <Button Content="SAVE PDF SHEET" Command="{Binding SaveAttendanceSheetPdfCommand}" Style="{StaticResource GoldActionButton}" Height="38" Margin="0,0,8,0"/>
                                        <Button Content="PRINT" Command="{Binding PrintAttendanceSheetCommand}" Style="{StaticResource MaterialDesignFlatButton}" Height="38" Margin="0,0,12,0"/>

                                        <Button Command="{Binding NavigatePreviousCommand}" Style="{StaticResource MaterialDesignFlatButton}" Width="36" Height="36" Padding="0" Margin="0,0,4,0">
                                            <materialDesign:PackIcon Kind="ChevronLeft" Width="20" Height="20"/>
                                        </Button>
                                        <Button Command="{Binding NavigateNextCommand}" Style="{StaticResource MaterialDesignFlatButton}" Width="36" Height="36" Padding="0">
                                            <materialDesign:PackIcon Kind="ChevronRight" Width="20" Height="20"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- 3-Card KPI Stat Strip -->
                            <UniformGrid Columns="3">
                                <Border Style="{StaticResource MetricCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="TOTAL REGISTERED" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,6"/>
                                        <TextBlock Text="{Binding TotalRegisteredCount}" FontSize="24" FontWeight="ExtraBold" Foreground="#0F172A"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource MetricCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="ATTENDEES RECORDED TODAY" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,6"/>
                                        <TextBlock Text="{Binding TodayAttendeeCount}" FontSize="24" FontWeight="ExtraBold" Foreground="{StaticResource ThemePrimaryActionBrush}"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource MetricCardStyle}" Margin="0">
                                    <StackPanel>
                                        <TextBlock Text="REMAINING SEAT CAPACITY" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,6"/>
                                        <TextBlock Text="{Binding RemainingCapacity}" FontSize="24" FontWeight="ExtraBold" Foreground="#0F172A"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                        </StackPanel>

                        <!-- 2. SCANNER STATUS BAR & REALTIME FILTER -->
                        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1,1,1,0" CornerRadius="12,12,0,0" Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Column="0" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         materialDesign:HintAssist.Hint="Search attendees by name, civil ID, or scan code..."
                                         Height="40" Margin="0,0,16,0"/>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="EDIT ATTENDANCE" Command="{Binding EditAttendanceCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Height="36" Margin="0,0,8,0"/>
                                    <Button Content="DELETE" Command="{Binding DeleteAttendanceCommand}" Style="{StaticResource MaterialDesignFlatButton}" Foreground="{StaticResource BrandRedBrush}" Height="36" Margin="0,0,8,0"/>

                                    <Button Content="REFRESH DATA" Command="{Binding RefreshWorkspaceCommand}"
                                            Style="{StaticResource MaterialDesignOutlinedButton}" Height="36"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- 3. ATTENDANCE DATAGRID (Paginated) -->
                        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1,0,1,1" CornerRadius="0,0,12,12" Padding="0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <DataGrid Grid.Row="0" ItemsSource="{Binding SavedAttendanceRows}"
                                          SelectedItem="{Binding SelectedAttendanceRow}"
                                          AutoGenerateColumns="False" CanUserAddRows="False"
                                          IsReadOnly="True" BorderThickness="0"
                                          GridLinesVisibility="Horizontal"
                                          HorizontalGridLinesBrush="#F1F5F9"
                                          AlternatingRowBackground="#F8FAFC"
                                          RowHeight="46" FontSize="12">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="CIVIL ID" Binding="{Binding CivilRegistryId}" Width="120"/>
                                        <DataGridTextColumn Header="ATTENDEE NAME" Binding="{Binding FullName}" Width="*" FontWeight="SemiBold"/>
                                        <DataGridTextColumn Header="CONTACT" Binding="{Binding ContactNumber}" Width="130"/>
                                        <DataGridTextColumn Header="DATE" Binding="{Binding AttendanceDateText}" Width="110"/>
                                        <DataGridTextColumn Header="TIME IN" Binding="{Binding TimeInText}" Width="100"/>
                                        <DataGridTextColumn Header="STATUS" Binding="{Binding StatusText}" Width="120"/>
                                        <DataGridTemplateColumn Header="ACTIONS" Width="140">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Button Content="EDIT" Command="{Binding DataContext.EditAttendanceCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                Style="{StaticResource MaterialDesignFlatButton}" Height="28" Padding="6,0" FontSize="11" Margin="0,0,4,0"/>
                                                        <Button Content="DEL" Command="{Binding DataContext.DeleteAttendanceCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                Style="{StaticResource MaterialDesignFlatButton}" Foreground="{StaticResource BrandRedBrush}" Height="28" Padding="6,0" FontSize="11"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <!-- 4. PAGINATION FOOTER (Fixed Bottom) -->
                                <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="16,10" CornerRadius="0,0,12,12">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Text="Page display: " FontSize="12" Foreground="#64748B" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding CurrentAttendancePageDisplay, FallbackValue='Page 1'}" FontSize="12" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Command="{Binding PreviousAttendancePageCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Height="32" Padding="12,0" Margin="0,0,8,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="ChevronLeft" Width="16" Height="16" VerticalAlignment="Center"/>
                                                    <TextBlock Text=" PREV" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Command="{Binding NextAttendancePageCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Height="32" Padding="12,0" Margin="0,0,4,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="NEXT " FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                                    <materialDesign:PackIcon Kind="ChevronRight" Width="16" Height="16" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

        <!-- ==================================================================================== -->
        <!-- MODAL OVERLAYS (BlurRadius="15.0" | Backdrop #CC0F172A)                              -->
        <!-- ==================================================================================== -->

        <!-- Seminar Editor Modal -->
        <Grid Grid.RowSpan="2" Panel.ZIndex="100" Visibility="{Binding SeminarEditorVisibility}">
            <Border Background="#CC0F172A"/>
            <Border Style="{StaticResource PanelCardStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" Width="680" MaxHeight="750">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{StaticResource ThemePrimaryActionBrush}" Padding="20,16" CornerRadius="16,16,0,0">
                        <DockPanel>
                            <TextBlock Text="{Binding SeminarEditorSubmitLabel, FallbackValue='SEMINAR CONFIGURATION'}" FontSize="16" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                            <Button Command="{Binding ClosePanelCommand}" Style="{StaticResource MaterialDesignFlatButton}" Foreground="White" DockPanel.Dock="Right" Padding="4" Height="32" Width="32">
                                <materialDesign:PackIcon Kind="Close" Width="20" Height="20"/>
                            </Button>
                        </DockPanel>
                    </Border>

                    <ScrollViewer Grid.Row="1" Padding="24" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="SEMINAR DETAILS" Style="{StaticResource SidebarHeaderStyle}"/>
                            <TextBox Text="{Binding SeminarEditorTitle, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignOutlinedTextBox}" materialDesign:HintAssist.Hint="Seminar / Training Title" Margin="0,0,0,16"/>
                            <TextBox Text="{Binding SeminarEditorLocation, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignOutlinedTextBox}" materialDesign:HintAssist.Hint="Training Venue / Hall" Margin="0,0,0,16"/>

                            <UniformGrid Columns="2" Margin="0,0,0,16">
                                <DatePicker SelectedDate="{Binding SeminarEditorStartDate}" materialDesign:HintAssist.Hint="Start Date" Margin="0,0,8,0"/>
                                <DatePicker SelectedDate="{Binding SeminarEditorEndDate}" materialDesign:HintAssist.Hint="End Date" Margin="8,0,0,0"/>
                            </UniformGrid>

                            <ComboBox ItemsSource="{Binding BenefitTypes}" SelectedItem="{Binding SeminarEditorBenefitType}"
                                      Style="{StaticResource MaterialDesignOutlinedComboBox}" materialDesign:HintAssist.Hint="Benefit / Allowance Type" Margin="0,0,0,16"/>

                            <TextBox Text="{Binding SeminarEditorDescription, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignOutlinedTextBox}" materialDesign:HintAssist.Hint="Training Overview / Agenda" Height="80" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,16"/>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="2" Background="#F8FAFC" Padding="20,16" CornerRadius="0,0,16,16" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,1,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="CANCEL" Command="{Binding ClosePanelCommand}" Style="{StaticResource MaterialDesignFlatButton}" Margin="0,0,10,0"/>
                            <Button Content="{Binding SeminarEditorSubmitLabel}" Command="{Binding SaveSeminarCommand}" Style="{StaticResource GoldActionButton}" Width="160" Height="42"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Scan Attendance Gateway (Mobile QR & PIN) Modal -->
        <Grid Grid.RowSpan="2" Panel.ZIndex="105" Visibility="{Binding ScanAttendanceVisibility}">
            <Border Background="#CC0F172A"/>
            <Border Style="{StaticResource PanelCardStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" Width="550">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{StaticResource ThemePrimaryActionBrush}" Padding="20,16" CornerRadius="16,16,0,0">
                        <DockPanel>
                            <TextBlock Text="MOBILE SCANNER GATEWAY" FontSize="16" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                            <Button Command="{Binding ClosePanelCommand}" Style="{StaticResource MaterialDesignFlatButton}" Foreground="White" DockPanel.Dock="Right" Padding="4" Height="32" Width="32">
                                <materialDesign:PackIcon Kind="Close" Width="20" Height="20"/>
                            </Button>
                        </DockPanel>
                    </Border>

                    <StackPanel Grid.Row="1" Margin="24" HorizontalAlignment="Center">
                        <Button Content="CREATE SCANNER SESSION" Command="{Binding CreateAttendanceScannerSessionCommand}" Style="{StaticResource GoldActionButton}" Height="42" Margin="0,0,0,16"/>

                        <Border Background="#0F172A" CornerRadius="12" Padding="20" HorizontalAlignment="Center">
                            <StackPanel HorizontalAlignment="Center">
                                <Image Source="{Binding AttendanceScannerQrImage}" Width="180" Height="180" Stretch="Uniform"/>
                                <TextBlock Text="SCANNER PIN" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,12,0,2"/>
                                <TextBlock Text="{Binding AttendanceScannerSessionPin}" FontSize="28" FontWeight="ExtraBold" Foreground="White" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding AttendanceScannerSessionUrl, Mode=OneWay}" FontSize="10" Foreground="#94A3B8" HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="320" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Border Grid.Row="2" Background="#F8FAFC" Padding="20,14" CornerRadius="0,0,16,16" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,1,0,0">
                        <Button Content="CLOSE GATEWAY" Command="{Binding ClosePanelCommand}" Style="{StaticResource MaterialDesignFlatButton}" HorizontalAlignment="Right"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Active Announcements Modal -->
        <Grid Grid.RowSpan="2" Panel.ZIndex="115" Visibility="{Binding AnnouncementsVisibility}">
            <Border Background="#CC0F172A"/>
            <Border Style="{StaticResource PanelCardStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" Width="720" MaxHeight="700">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{StaticResource ThemePrimaryActionBrush}" Padding="20,16" CornerRadius="16,16,0,0">
                        <DockPanel>
                            <TextBlock Text="ACTIVE SEMINAR ANNOUNCEMENTS" FontSize="16" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                            <Button Command="{Binding ClosePanelCommand}" Style="{StaticResource MaterialDesignFlatButton}" Foreground="White" DockPanel.Dock="Right" Padding="4" Height="32" Width="32">
                                <materialDesign:PackIcon Kind="Close" Width="20" Height="20"/>
                            </Button>
                        </DockPanel>
                    </Border>

                    <ScrollViewer Grid.Row="1" Padding="24" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding OpenAnnouncements}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource DetailCardStyle}" Padding="16" Margin="0,0,0,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="Bold" Foreground="#0F172A"/>
                                                <TextBlock Text="{Binding Summary}" FontSize="12" Foreground="#64748B" Margin="0,4,0,8" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding DateLabel}" FontSize="11" Foreground="#94A3B8"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="LOAD SEMINAR"
                                                    Command="{Binding DataContext.SelectAnnouncementEventCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                    CommandParameter="{Binding EventId}"
                                                    Style="{StaticResource GoldActionButton}" Height="36" Padding="16,0" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Border Grid.Row="2" Background="#F8FAFC" Padding="20,14" CornerRadius="0,0,16,16" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,1,0,0">
                        <Button Content="CLOSE" Command="{Binding ClosePanelCommand}" Style="{StaticResource MaterialDesignFlatButton}" HorizontalAlignment="Right"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- PC Scanner Camera Overlay -->
        <Grid Grid.RowSpan="2" Panel.ZIndex="120" Visibility="{Binding IsPcScannerOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <local:DesktopScannerOverlay QrCodeScanned="Scanner_QrCodeScanned" Closed="Scanner_Closed"/>
        </Grid>

        <!-- Scanned ID Confirmation Modal Overlay -->
        <Grid Grid.RowSpan="2" Panel.ZIndex="130"
              Visibility="{Binding IsScannedResultVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Background="#CC0F172A"/>
            <Border Style="{StaticResource PanelCardStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" Width="600" CornerRadius="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{StaticResource ThemePrimaryActionBrush}" Padding="20,16" CornerRadius="16,16,0,0">
                        <DockPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="AccountCheck" Width="24" Height="24" Foreground="White" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="ID SCAN ATTENDANCE CAPTURE" FontSize="16" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button Command="{Binding CancelScannedClaimCommand}" Style="{StaticResource MaterialDesignFlatButton}"
                                    Foreground="White" DockPanel.Dock="Right" Padding="4" Height="32" Width="32">
                                <materialDesign:PackIcon Kind="Close" Width="20" Height="20"/>
                            </Button>
                        </DockPanel>
                    </Border>

                    <Grid Grid.Row="1" Margin="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Border Width="120" Height="120" CornerRadius="12" Background="#F8FAFC" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
                                <Grid>
                                    <materialDesign:PackIcon Kind="AccountCircle" Width="72" Height="72" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource CardBorderBrush}"/>
                                    <Border CornerRadius="12" Visibility="{Binding ScannedBeneficiaryPhoto, Converter={StaticResource NullToHiddenConverter}}">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{Binding ScannedBeneficiaryPhoto}" Stretch="UniformToFill"/>
                                        </Border.Background>
                                    </Border>
                                </Grid>
                            </Border>
                            <TextBlock Text="{Binding ScannedBeneficiary.BeneficiaryId}" FontSize="11" FontWeight="Bold" Foreground="#0F172A" TextAlignment="Center" Margin="0,8,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ScannedBeneficiary.FullName}" FontSize="20" FontWeight="Bold" Foreground="#0F172A" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding ScannedBeneficiaryStatus}" FontSize="13" Foreground="{StaticResource ThemePrimaryActionBrush}" FontWeight="SemiBold" Margin="0,4,0,12"/>

                            <Border Margin="0,0,0,14" Padding="12,8" CornerRadius="8" Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1"
                                    Visibility="{Binding IsScannedBeneficiaryEligible, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="AlertCircle" Width="18" Height="18" VerticalAlignment="Center" Foreground="#DC2626" Margin="0,0,8,0"/>
                                    <TextBlock Text="Attendee has already been recorded present for today's session." FontSize="11" FontWeight="SemiBold" Foreground="#991B1B" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#F8FAFC" Padding="16,12" CornerRadius="8" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Civil Registry ID:" FontSize="12" Foreground="#64748B" Margin="0,0,12,6"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ScannedBeneficiary.CivilRegistryId, TargetNullValue='N/A'}" FontSize="12" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,0,6"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Seminar Assignment:" FontSize="12" Foreground="#64748B" Margin="0,0,12,0"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedEvent.Title}" FontSize="12" FontWeight="SemiBold" Foreground="#0F172A" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="2" Background="#F8FAFC" Padding="20,16" CornerRadius="0,0,16,16" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,1,0,0">
                        <DockPanel LastChildFill="False">
                            <Button Content="CANCEL" Command="{Binding CancelScannedClaimCommand}" Style="{StaticResource MaterialDesignFlatButton}" Height="40" Padding="20,0" DockPanel.Dock="Left" Foreground="#64748B"/>
                            <Button Content="CONFIRM ATTENDANCE" Command="{Binding ConfirmScannedClaimCommand}" Visibility="{Binding IsScannedBeneficiaryEligible, Converter={StaticResource BooleanToVisibilityConverter}}" Style="{StaticResource GoldActionButton}" Height="44" Padding="24,0" DockPanel.Dock="Right"/>
                            <Border Visibility="{Binding IsScannedBeneficiaryEligible, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                                    Background="#FEE2E2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="8" Padding="14,8" DockPanel.Dock="Right" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Cancel" Width="16" Height="16" Foreground="#DC2626" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="ALREADY RECORDED TODAY" FontSize="12" FontWeight="Bold" Foreground="#991B1B" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
