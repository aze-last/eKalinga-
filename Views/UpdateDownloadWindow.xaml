<Window x:Class="AttendanceShiftingManagement.Views.UpdateDownloadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Downloading Update"
        Width="440"
        Height="280"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="White"
        FontFamily="Segoe UI"
        WindowStyle="None"
        AllowsTransparency="True">

    <Border BorderBrush="#E2E8F0"
            BorderThickness="1"
            CornerRadius="16"
            Background="White"
            Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.1"/>
        </Border.Effect>

        <StackPanel Margin="32,28">
            <StackPanel Orientation="Horizontal">
                <Border Width="44"
                        Height="44"
                        CornerRadius="22"
                        Background="#FFFBEB"
                        BorderBrush="#F59E0B"
                        BorderThickness="1"
                        VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="Download"
                                              Width="22"
                                              Height="22"
                                              Foreground="#F59E0B"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                </Border>
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Downloading Update"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="#15803D"/>
                    <TextBlock Text="{Binding StatusText, Mode=OneWay}"
                               Margin="0,4,0,0"
                               FontSize="13"
                               Foreground="#64748B"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </StackPanel>

            <ProgressBar Margin="0,20,0,0"
                         Height="12"
                         Minimum="0"
                         Maximum="100"
                         Value="{Binding ProgressPercent, Mode=OneWay}"
                         Foreground="#F59E0B"
                         Background="#F1F5F9"
                         BorderThickness="0"/>

            <TextBlock Margin="0,8,0,0"
                       HorizontalAlignment="Right"
                       Text="{Binding PercentLabel, Mode=OneWay}"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="#0F172A"/>

            <Button x:Name="CancelButton"
                    Content="CANCEL"
                    Margin="0,16,0,0"
                    Height="40"
                    Style="{StaticResource MaterialDesignFlatButton}"
                    Background="#F1F5F9"
                    Foreground="#0F172A"
                    FontSize="13"
                    FontWeight="Bold"
                    materialDesign:ButtonAssist.CornerRadius="10"
                    Click="Cancel_Click"/>
        </StackPanel>
    </Border>
</Window>
